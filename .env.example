# ============================================================
# ViperRange — Environment Variables
# ZeroDay Security Services
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ViperRange
NODE_ENV=development

# --- Database (Neon PostgreSQL — free tier) ---
# Get from: https://neon.tech/
DATABASE_URL="postgresql://user:password@host/viperrange?sslmode=require"

# --- Auth (NextAuth v5 / Auth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-char-secret-here"
AUTH_URL=http://localhost:3000

# --- Render & Local Labs (Lab Deployment) ---
# Get from: https://dashboard.render.com/u/settings/api-keys
# For local dev, set RENDER_API_KEY to: development_bypass
RENDER_API_KEY=development_bypass
RENDER_OWNER_ID=your-render-owner-id
# Set to true to route deployed labs to local docker containers (ports 8081-8088)
LOCAL_LABS_ENABLED=true
LOCAL_LABS_BASE_URL=http://localhost

# --- Rate Limiting (Upstash Redis — free tier) ---
# Get from: https://upstash.com/
# OPTIONAL: Leave empty to use in-memory rate limiting in dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Logging (Better Stack — free tier) ---
# Get from: https://betterstack.com/logs
# OPTIONAL: Leave empty to use console logging in dev
BETTERSTACK_SOURCE_TOKEN=

# --- Admin ---
# Email addresses with admin privileges (comma-separated)
ADMIN_EMAILS=admin@zeroday.in

# --- Security ---
BCRYPT_ROUNDS=12
