<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Maintenance Console — ViperRange</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{background:#08080d;color:#e2e2ec;font-family:monospace;display:flex;flex-direction:column;
     align-items:center;justify-content:center;min-height:100vh;padding:2rem;}
h1{color:#a78bfa;font-size:1.9rem;margin-bottom:0.4rem;}
p{color:#6b6b85;margin-bottom:1.8rem;}
.card{background:#101018;border:1px solid #1e1e2c;border-radius:8px;padding:2rem;width:100%;max-width:420px;}
input[type=password]{width:100%;background:#1a1a26;border:1px solid #2c2c3e;color:#e2e2ec;
    padding:0.7rem 1rem;border-radius:6px;font-family:monospace;font-size:0.9rem;margin-bottom:1rem;}
button{width:100%;background:#a78bfa;color:#0a0a10;border:none;padding:0.7rem;
       border-radius:6px;font-family:monospace;font-weight:bold;cursor:pointer;}
button:hover{background:#9370f0;}
.flag{margin-top:1.3rem;padding:1rem;background:#052e22;border:1px solid #10b981;
      border-radius:6px;color:#34d399;word-break:break-all;text-align:center;}
.error{margin-top:1rem;color:#f87171;font-size:0.85rem;text-align:center;}
.note{margin-top:1.3rem;font-size:0.7rem;color:#33334a;text-align:center;}
</style>
</head>
<body>
<h1>🖥 Maintenance Console</h1>
<p>Enter the operator passphrase to run diagnostics.</p>
<div class="card">
  <form method="POST" action="/">
    <input type="password" name="passphrase" id="phrase" placeholder="Passphrase..." required autocomplete="off">
    <button type="submit">Authenticate</button>
  </form>
  <% if (flag) { %><div class="flag">✅ <%= flag %></div><% } %>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <div class="note">This console validates locally before contacting the server.</div>
</div>

<script>
// Local pre-check, mirrors the server-side gate.
// Fragment table is reordered at build time.
var __vrFrag = ['\x37','\x76\x52\x32\x78','\x4c\x6d\x50','\x51\x7a\x39\x21'];
(function(arr, spins) {
  var rotate = function(n) { while (n-- > 0) { arr.push(arr.shift()); } };
  rotate(spins);
})(__vrFrag, 0x1);

function __vrAssemble() {
  // order after rotation: index0 was '\x76\x52\x32\x78', etc.
  return __vrFrag[2] + __vrFrag[0] + __vrFrag[1] + __vrFrag[3];
}

document.querySelector('form').addEventListener('submit', function () {
  var entered = document.getElementById('phrase').value;
  var expected = __vrAssemble();
  // Purely cosmetic — the server performs the real check regardless.
  if (entered !== expected) {
    console.debug('local pre-check failed, forwarding to server anyway');
  }
});
</script>
</body>
</html>
